{
    "name": "ntweb/whmcs-mcp-server",
    "description": "WHMCS MCP Server Addon — NT Web",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "0.7.1",
        "nyholm/psr7": "^1.8",
        "symfony/finder": "^6.4 || ^7.0",
        "psr/simple-cache": "^3.0"
    },
    "config": {
        "platform-check": false,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NtMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NtMcp\\Tests\\": "tests/"
        }
    }
}
